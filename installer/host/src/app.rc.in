// Generated by CMake (installer/host/CMakeLists.txt) for each build:
// the wizard HTML, the MSI payload and the icon are embedded as resources so
// wilfred-setup.exe is a single self-contained file.

#include <windows.h>

#define IDR_SETUP_HTML 101
#define IDR_SETUP_MSI 102
#define IDI_APPICON 103

IDI_APPICON ICON "@SETUP_ICON_NATIVE@"
IDR_SETUP_HTML RCDATA "@SETUP_HTML_NATIVE@"
IDR_SETUP_MSI RCDATA "@SETUP_MSI_NATIVE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SETUP_VERSION_COMMA@
 PRODUCTVERSION @SETUP_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wilfred Open Contributors"
            VALUE "FileDescription", "Wilfred Setup"
            VALUE "FileVersion", "@SETUP_VERSION@"
            VALUE "InternalName", "wilfred-setup"
            VALUE "LegalCopyright", "Copyright (c) 2026 Wilfred contributors"
            VALUE "OriginalFilename", "wilfred-setup.exe"
            VALUE "ProductName", "Wilfred"
            VALUE "ProductVersion", "@SETUP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
