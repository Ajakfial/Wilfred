prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: spoke
Description: From-scratch offline English transcription engine (no whisper code)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lspoke
Cflags: -I${includedir}
