#include <windows.h>

// Version resource for wilfred.exe. Configured by CMake from
// cmake/win_version_info.rc.in so every Windows build (local or CI)
// carries the same publisher identity in Explorer file properties.
// NOTE: VERSIONINFO sets the displayed CompanyName only. It does not
// confer SmartScreen trust; that requires Authenticode signing, see
// docs/signing.md and scripts/Sign-WindowsBinary.ps1.

LANGUAGE 0x09, 0x01

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS VS_FF_DEBUG
#else
  FILEFLAGS 0x0L
#endif
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Wilfred Open Contributors"
      VALUE "FileDescription", "Wilfred - fast desktop search and launcher"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "wilfred"
      VALUE "LegalCopyright", "Wilfred Open Contributors"
      VALUE "OriginalFilename", "wilfred.exe"
      VALUE "ProductName", "Wilfred"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
